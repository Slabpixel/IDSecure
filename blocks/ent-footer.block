<!-- <script>console.log({@|json-pretty})</script> -->

<div class="ent-container no-p">
  <div class="ent-footer_container">
    <div class="ent-footer_side">
      {@|apply eyebrow-48-alt.block}
      <div class="ent-footer_side-block">
        <p>
          Connect what matters. Monitor what changes. Manage it all from one
          view.
        </p>
        <div class="ent-footer_side-address">
          <a href="mailto:"> enquiries@idsecure.tech </a>
          <p>2255 GLADES ROAD, SUITE 324A, BOCA RATON, 33431, FL, USA</p>
        </div>
      </div>
    </div>
    <div class="ent-footer_menu">
      <div class="footer-menu-list">
        <a href="/solutions" class="fs-14 cl-grey uppercase">Solutions</a>
        <ul class="footer-ul">
          {.repeated section items.3.items}
          <li class="foot-menu-item uppercase">
            <a href="{collection.fullUrl}">{collection.navigationTitle}</a>
          </li>
          {.end}
        </ul>
      </div>
      <div class="footer-menu-list">
        <a href="/use-cases" class="fs-14 cl-grey uppercase">Use Cases</a>
        <ul class="footer-ul">
          {.repeated section items.4.items}
          <li class="foot-menu-item uppercase">
            <a href="{collection.fullUrl}">{collection.navigationTitle}</a>
          </li>
          {.end}
        </ul>
      </div>
      <div class="footer-menu-list">
        <a href="/industries" class="fs-14 cl-grey uppercase">Industries</a>
        <ul class="footer-ul">
          {.repeated section items.5.items}
          <li class="foot-menu-item uppercase">
            <a href="{collection.fullUrl}">{collection.navigationTitle}</a>
          </li>
          {.end}
        </ul>
      </div>
      <div class="footer-menu-list">
        <span class="fs-14 cl-grey uppercase">Company</span>
        <ul class="footer-ul">
          <li class="foot-menu-item uppercase">
            <a href="/about-us">About Us</a>
          </li>
          {.repeated section items.6.items}
          <li class="foot-menu-item uppercase">
            <a href="{collection.fullUrl}">{collection.navigationTitle}</a>
          </li>
          {.end}
        </ul>
      </div>
    </div>
  </div>
</div>
