<section class="ent-section hero">
  <div class="ent-container hero">
    <div class="ent-content max-w-1032">
      <div class="ent-title-wrap gap-24">
        <div class="ent-eyebrow">
          <img src="/assets/fp-icon.svg" alt="" />
          <span>ENTERPRISE CONNECTIVITY & MONITORING</span>
        </div>
        <h1>
          Connected visibility for distributed and asset-intensive industries
        </h1>
        <p class="ent-description max-w-682">
          IDSECURE helps enterprise organizations connect, monitor, and manage
          operations across remote sites, facilities, fleets, assets, sensors,
          and critical environments.
        </p>
      </div>
      <div class="ent-button-wrap">
        <a href="#" class="btn-ent-brand">Talk to IDSecure</a>
        <a href="#" class="btn-ent-ghost">Explore Solutions</a>
      </div>
    </div>
  </div>
  <div class="ent-hero-bg">
    <video
      src="/assets/ent-hero-iot.webm"
      autoplay
      muted
      loop
      playsinline
    ></video>
    <div class="ent-hero-bg_overlay"></div>
  </div>
</section>
<section class="ent-section">
  <div class="ent-container md">
    <div class="ent-content gap-80">
      <div class="ent-title-wrap">
        <div class="ent-eyebrow">
          <img src="/assets/fp-icon.svg" alt="" />
          <span>APPROACH</span>
        </div>
        <h2>Built for real operating environments</h2>
      </div>
      <div class="ent-content_inner">
        <div class="ent-content_img">
          <img src="/assets/ent-industries.svg" alt="Enterprise About Image" />
        </div>
        <div class="ent-description_wrap max-w-626">
          <hr class="ent-description_divider" />
          <p class="text-md text-primary-lighter">
            Enterprise industries are increasingly distributed, asset-intensive,
            and dependent on real-time operational data.
          </p>
          <p class="text-md text-primary-lighter">
            IDSECURE helps bring connectivity, monitoring, and centralized
            management into the environments where work actually happens.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
