<div class="ent-hero">
  <section class="ent-section hero">
    <div class="ent-container hero">
      <div class="ent-content max-w-1032">
        <div class="ent-title-wrap gap-24">
          <div class="ent-eyebrow">
            <img src="/assets/fp-icon.svg" alt="" />
            <span>ENTERPRISE CONNECTIVITY & MONITORING</span>
          </div>
          <h1>
            End-to-end IoT monitoring for assets, environments, facilities, and
            field operations
          </h1>
          <p class="ent-description max-w-682">
            SenseHQ unifies devices, sensors, gateways, dashboards, alerts,
            automation, reports, and integrations so teams can see more, act
            faster, and scale monitoring with confidence.
          </p>
        </div>
        <div class="ent-button-wrap">
          <a href="/enterprise-contact" class="btn-ent-brand">Talk to IDSecure</a>
          <a href="/use-cases" class="btn-ent-ghost">Explore Monitoring Use Cases</a>
        </div>
      </div>
    </div>
  </section>
  <div class="ent-hero-bg">
    <video
      src="/assets/ent-hero-sense.webm"
      autoplay
      muted
      loop
      playsinline
    ></video>
    <div class="ent-hero-bg_overlay"></div>
    <div class="ent-section inside-hero">
      <div class="ent-container"></div>
    </div>
  </div>
</div>
