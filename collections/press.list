<section class="gov-section gov-press">
  <div class="bg-dots-top">
    <img src="/assets/dots-top.png" alt="Dots Top" />
  </div>
  <div class="gov-container gov-press-cont">
    <div class="gov-press-intro">
      <div class="gov-title-wrap">
        <span class="gov-eyebrow muted">[OUR PRESS]</span>
        <h1>Who's Talking<br />About us</h1>
      </div>
    </div>
    <div class="gov-press-grid-wrap">
      <template id="gov-press-soon-template">
        <div class="gov-press-card gov-press-card--placeholder gov-press-card--soon">
          <div class="gov-press-card-glow" aria-hidden="true"></div>
          <div class="gov-press-card-fingerprint" aria-hidden="true">
            <img src="/assets/fingerprint.png" alt="" />
          </div>
          <div class="gov-press-card-inner soon">
            <h2 class="gov-press-card-title">Coming<br />Soon</h2>
          </div>
        </div>
      </template>
      <div class="gov-press-grid">
        {.repeated section items}
          {.section assetUrl}
          <a href="{fullUrl}" class="gov-press-card gov-press-card--image">
            <div class="gov-press-card-media" aria-hidden="true">
              <img src="{assetUrl}" alt="" />
            </div>
          {.or}
          <a href="{fullUrl}" class="gov-press-card gov-press-card--placeholder">
            <div class="gov-press-card-glow" aria-hidden="true"></div>
            <div class="gov-press-card-fingerprint" aria-hidden="true">
              <img src="/assets/fingerprint.svg" alt="" />
            </div>
          {.end}
            <div class="gov-press-card-inner">
              <div class="gov-press-card-meta">
                <span class="gov-press-card-category">{categories}</span>
                <span class="gov-press-card-dot" aria-hidden="true"></span>
                <time class="gov-press-card-date">{addedOn|date %b %d, %Y}</time>
              </div>
              <h2 class="gov-press-card-title">{title}</h2>
            </div>
          </a>
        {.end}
      </div>
      <div class="gov-press-grid-fade gov-press-grid-fade--top" aria-hidden="true"></div>
      <div class="gov-press-grid-fade gov-press-grid-fade--bottom" aria-hidden="true"></div>
    </div>
  </div>
</section>

<section class="gov-section-contact">
  <div class="container section-contact-cont">
    <div class="flex-col-left flex-24 gov-contact-details">
      {@|apply eyebrow-48.block}
      <div class="gov-contact-title" id="sec-contact-title">
        Contact us for more Details!
      </div>
      <div class="flex-col-left flex-16">
        <div class="grid-item-p fs-14">
          <squarespace:block-field id="secContactEmail" />
        </div>
        <div class="grid-item-p fs-14">
          <squarespace:block-field id="secContactAddress" />
        </div>
      </div>
    </div>
    <div class="gov-contact-banner">
      <div class="gov-contact-banner-top">
        <h2>
          Start with the <br />
          Collection Environment
        </h2>
      </div>
      <div class="gov-contact-banner-bottom">
        <div class="contact-banner-bottom-text">
          If the mission requires multi-modal biometric and biographic
          intelligence to be collected in a rugged, customizable and deployable
          modality, start with Mobile Biometric Collection Kits.
        </div>
        <a href="/contact" class="btn-ghost">Request Product Briefing</a>
      </div>
    </div>
    <div class="gov-contact-bg"></div>
  </div>
</section>

<script src="../scripts/script.js"></script>
